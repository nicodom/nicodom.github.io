---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const stack: [string, string][] = [
	['cloud & infra', 'AWS, Kubernetes, ArgoCD, Helm, Serverless, Step Functions, Lambda'],
	['streaming & messaging', 'Kafka, Kafka Streams, Kafka Connect, KSQL, Flink, Confluent, CDC (Debezium)'],
	['architecture', 'Microservices, EDA, CQRS, Event Sourcing, Data Mesh'],
	['languages', 'Python, Scala, Java, Kotlin, Node.js, PHP, Ruby'],
	['data & storage', 'DynamoDB, PostgreSQL, MySQL, Redshift, Snowflake, Iceberg'],
	['identity, observability & ipaas', 'Datadog, Eppo, LaunchDarkly, Okta/Auth0, Fivetran, Patchworks'],
];

// Rendered as its own full-width row at the end of the stack matrix (see
// .stack-cell--full), rather than as a regular 2-column grid cell, so it
// doesn't leave an empty cell beside it.
const stackFull: [string, string] = [
	'ai & agents',
	'Claude Code, agentic AI governance, OWASP LLM06, Team Topologies for AI adoption',
];

// The stack matrix is a 2-column grid; the last visual row of the regular
// (non-full-width) cells — the final 1 or 2, depending on odd/even count —
// shouldn't get a bottom border so it doesn't double up against the full-
// width row's own top edge.
const stackLastRowStart = stack.length - (stack.length % 2 === 0 ? 2 : 1);

// Every role comes from src/content/experience/: frontmatter feeds the card,
// the markdown body goes in the expandable "more" section.
const jobs = await Promise.all(
	(await getCollection('experience'))
		.sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf())
		.map(async (job) => ({ ...job, Content: (await render(job)).Content, hasBody: Boolean(job.body?.trim()) })),
);

// Content dates are parsed as UTC midnight, so format in UTC to avoid off-by-one months.
const month = (date: Date) => `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}`;
const years = (start: Date, end?: Date) => {
	const from = start.getUTCFullYear();
	const to = end ? end.getUTCFullYear() : 'present';
	return from === to ? String(from) : `${from}-${to}`;
};

const roles = jobs.filter((job) => !job.data.earlier);
const earlier = jobs.filter((job) => job.data.earlier);
const earlierFrom = Math.min(...earlier.map((job) => job.data.startDate.getUTCFullYear()));
const earlierTo = Math.max(...earlier.map((job) => (job.data.endDate ?? job.data.startDate).getUTCFullYear()));
---

<BaseLayout title="Experience | Domenico Fioravanti" description="Professional experience and technology skills.">
	<h1>Twenty-five years of platforms &amp; people</h1>
	<p class="tagline-lead">
		From founding two software companies to leading distributed engineering organisations
		across Europe, the US, and South America.
	</p>

	<section>
		<span class="section-label bracket-label">stack --list</span>
		<div class="stack-grid">
			{stack.map(([category, items], i) => (
				<div class={`stack-cell${i >= stackLastRowStart ? ' stack-cell--last-row' : ''}`}>
					<span class="stack-label">{category}</span>
					<span class="stack-desc">{items}</span>
				</div>
			))}
			<div class="stack-cell stack-cell--full">
				<span class="stack-label">{stackFull[0]}</span>
				<span class="stack-desc">{stackFull[1]}</span>
			</div>
		</div>
	</section>

	<section>
		<span class="section-label bracket-label">git log --roles</span>
		<div class="timeline">
			{roles.map(({ data, Content, hasBody }, i) => (
				<>
					<div class="timeline-marker">
						<span class={`timeline-dot ${data.endDate ? '' : 'timeline-dot--current'}`}></span>
						{i < roles.length - 1 && <span class="timeline-line"></span>}
					</div>
					<div class="timeline-content">
						<div class="timeline-heading">
							<span class="timeline-title">{data.role}</span>
							{!data.endDate && <span class="head-badge">HEAD</span>}
						</div>
						<p class="timeline-company">
							{data.company}
							{data.location && <> &middot; {data.location}</>}
						</p>
						<p class="timeline-when">
							{month(data.startDate)} &rarr; {data.endDate ? month(data.endDate) : 'present'}
						</p>
						{data.summary && <p class="timeline-body">{data.summary}</p>}
						{data.techStack && data.techStack.length > 0 && (
							<div class="timeline-tags">
								{data.techStack.map((tag) => <span class="tag">{tag}</span>)}
							</div>
						)}
						{hasBody && (
							<details class="role-more">
								<summary>more</summary>
								<div class="role-more-body">
									<Content />
								</div>
							</details>
						)}
					</div>
				</>
			))}
			{earlier.length > 0 && (
				<>
					<div class="timeline-marker">
						<span class="timeline-dot"></span>
					</div>
					<div class="timeline-content">
						<p class="timeline-title" style="font-size:1.05rem;">Earlier career</p>
						<p class="timeline-when">{earlierFrom} &rarr; {earlierTo}</p>
						<div class="earlier-list">
							{earlier.map(({ data, Content, hasBody }) => (
								<details class="earlier-row">
									<summary>
										<span>{data.role} &mdash; {data.company}</span>
										<span class="when">{years(data.startDate, data.endDate)}</span>
									</summary>
									<div class="role-more-body">
										{data.summary && <p>{data.summary}</p>}
										{hasBody && <Content />}
									</div>
								</details>
							))}
						</div>
					</div>
				</>
			)}
		</div>
	</section>
</BaseLayout>

<style>
	.role-more {
		margin-top: 0.85rem;
	}
	.role-more > summary,
	.earlier-row > summary {
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--muted);
	}
	.role-more > summary:hover,
	.earlier-row > summary:hover {
		color: var(--accent);
	}
	/* theme.css lays .earlier-row out as a flex row; as a <details> the summary carries that layout instead. */
	.earlier-row {
		display: block;
	}
	.earlier-row > summary {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;
		font-family: inherit;
		font-size: inherit;
		color: inherit;
	}
	.earlier-row > summary::-webkit-details-marker {
		display: none;
	}
	.earlier-row > summary::before {
		content: '+';
		font-family: var(--font-mono);
		color: var(--muted);
		margin-right: -1rem;
	}
	.earlier-row[open] > summary::before {
		content: '−';
	}
	.earlier-row > summary > span:first-of-type {
		flex: 1;
	}
	.role-more-body {
		font-size: 0.85rem;
		line-height: 1.65;
		max-width: 42rem;
		margin-top: 0.6rem;
		color: var(--fg);
	}
	.role-more-body :global(p),
	.role-more-body :global(ul) {
		margin: 0 0 0.6rem;
	}
	.role-more-body :global(ul) {
		padding-left: 1.1rem;
	}
	.role-more-body :global(li + li) {
		margin-top: 0.25rem;
	}
</style>
