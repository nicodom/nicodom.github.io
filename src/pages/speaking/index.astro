---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TalkItem from '../../components/TalkItem.astro';

const talks = await getCollection('speaking');
const now = new Date();

const upcoming = talks
	.filter((talk) => talk.data.date.valueOf() >= now.valueOf())
	.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = talks
	.filter((talk) => talk.data.date.valueOf() < now.valueOf())
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Speaking | Domenico Fioravanti" description="Conference talks and speaking engagements.">
	<h1>Speaking</h1>
	{talks.length === 0 && <p>Talks coming soon.</p>}

	{upcoming.length > 0 && (
		<section>
			<h2 class="section-label section-heading">Upcoming</h2>
			<ul class="entry-list">
				{upcoming.map((talk) => <TalkItem talk={talk} />)}
			</ul>
		</section>
	)}

	{past.length > 0 && (
		<section>
			<h2 class="section-label section-heading">Past</h2>
			<ul class="entry-list">
				{past.map((talk) => <TalkItem talk={talk} />)}
			</ul>
		</section>
	)}
</BaseLayout>
