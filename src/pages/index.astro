---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GITHUB_URL, LINKEDIN_URL } from '../lib/contact';

const stats = [
	{ value: '25+', label: 'years_experience' },
	{ value: '45+', label: 'engineers_led' },
	{ value: '03', label: 'continents' },
	{ value: 'DUB', label: 'based_in_ireland' },
];

const achievements = [
	'Built engineering orgs from scratch to 45+ people',
	'Led architecture transformation from data monolith to event-driven data mesh',
	'Designed and delivered a multi-tenant, multi-country integration platform supporting real-time data ingestion and orchestration across IE, UK, and US markets',
	'Accelerated delivery and improved platform reliability through a Team Topologies redesign',
	'Developed and presented an original framework applying Team Topologies, Data Mesh and OWASP LLM06 principles to govern AI agent adoption, addressing bounded scope, guardrails, and human oversight at organisational scale',
];

const signalFlags = [
	'org-design',
	'event-driven',
	'data-mesh',
	'distributed-systems',
	'integration',
	'observability',
	'team-topologies',
	'agentic-ai',
	'mentorship',
	'public-speaking',
];

const explore = [
	{ href: '/experience/', kicker: '~/experience', title: 'Timeline & stack', desc: 'Full role history and technology depth' },
	{ href: '/speaking/', kicker: '~/speaking', title: 'Talks & podcasts', desc: 'Conference talks and guest appearances' },
	{ href: '/community/', kicker: '~/community', title: 'Organizing', desc: 'Meetups and practitioner communities' },
];

const languages = [
	{ name: 'Italian', level: 'Native' },
	{ name: 'English', level: 'Fluent' },
	{ name: 'French', level: 'Intermediate' },
	{ name: 'German', level: 'Basic' },
	{ name: 'Spanish', level: 'Basic' },
];
---

<BaseLayout title="Domenico Fioravanti — Senior Engineering Leader">
	<section class="hero">
		<span class="section-label">Senior Engineering Leader &middot; Sociotechnical Architect</span>
		<h1>Domenico Fioravanti</h1>
		<p class="tagline-lead">
			<span class="prompt-marker">&gt;</span>
			Aligning team structures, ways of working, platform architecture, and AI adoption to
			maximise flow, resilience, and business outcomes.<span class="cursor" aria-hidden="true"></span>
		</p>
		<div class="cta-row">
			<div class="social-inline">
				<a href={LINKEDIN_URL}>LinkedIn</a>
				<span aria-hidden="true">&middot;</span>
				<a href={GITHUB_URL}>GitHub</a>
			</div>
		</div>
		<div class="stats">
			{stats.map((stat) => (
				<div class="stat">
					<span class="stat-value">{stat.value}</span>
					<span class="stat-label">{stat.label}</span>
				</div>
			))}
		</div>
	</section>

	<section>
		<span class="section-label section-heading">profile</span>
		<p>
			Engineering leader with 25+ years of experience building and scaling tech orgs across
			Europe, US, and LATAM, and data-intensive platforms. I operate as a Sociotechnical
			Architect, intentionally aligning team structures, ways of working, and platform
			architecture to maximise flow, resilience, and business outcomes.
		</p>
		<p>
			Specialist in event-driven architecture, real-time data pipelines, and integration
			ecosystems, from Kafka-based streaming to third-party API and partner integrations.
			Proven track record of building engineering organisations from zero to 45+ people,
			leading complex platform modernisations, and driving scalable, high-reliability systems
			across e-commerce, healthcare, and SaaS.
		</p>
		<p>
			Actively shaping engineering organisation design for the agentic AI era, applying Team
			Topologies and bounded-agency principles to govern AI adoption safely at scale, while
			driving hands-on adoption of AI-assisted development across engineering teams.
		</p>
		<p>
			Regular speaker and community organiser on event streaming, data platforms, and engineering
			organisation design.
		</p>
	</section>

	<section>
		<span class="section-label section-heading">achievements</span>
		<ol class="achievements">
			{achievements.map((item) => (
				<li>
					<span class="idx">ok</span>
					<span>{item}</span>
				</li>
			))}
		</ol>
	</section>

	<section>
		<span class="section-label section-heading">focus</span>
		<ul class="chip-list">
			{signalFlags.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section>
		<span class="section-label section-heading">Explore</span>
		<ul class="explore-grid">
			{explore.map((item) => (
				<li>
					<a class="explore-card" href={item.href}>
						<span class="explore-kicker">{item.kicker}</span>
						<span class="explore-title">{item.title}</span>
						<span class="explore-desc">{item.desc}</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section>
		<div class="split-grid">
			<div class="split-col">
				<span class="section-label section-heading">Education</span>
				<ul class="plain-list">
					<li>
						<strong>MSc Computer Science / Software Engineering</strong> — University of Rome
						"La Sapienza"
					</li>
					<li><strong>European Baccalaureate</strong> — European School Brussels I</li>
				</ul>
			</div>
			<div class="split-col">
				<span class="section-label section-heading">Languages</span>
				<ul class="plain-list inline">
					{languages.map((lang) => (
						<li>{lang.name} <span class="lang-level">{lang.level}</span></li>
					))}
				</ul>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero h1 {
		margin-bottom: 0.25rem;
	}
	.explore-grid {
		margin: 1rem 0 0;
	}
</style>
