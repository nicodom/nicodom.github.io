---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { LINKEDIN_URL } from '../lib/contact';
import domenicoPhoto from '../assets/domenico.jpg';
import topologiesPreview from '../assets/topologies.png';

const now = new Date();

function formatEventDate(date: Date) {
	return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const upcomingTalks = (await getCollection('speaking'))
	.filter((talk) => talk.data.date.valueOf() >= now.valueOf())
	.map((talk) => ({
		kind: 'Speaking',
		title: talk.data.title,
		context: talk.data.event,
		date: talk.data.date,
		href: talk.data.eventUrl ?? '/speaking/',
	}));

const upcomingCommunity = (await getCollection('community'))
	.filter((activity) => (activity.data.endDate ?? activity.data.startDate).valueOf() >= now.valueOf())
	.map((activity) => ({
		kind: 'Community',
		title: activity.data.title,
		context: activity.data.organization,
		date: activity.data.startDate,
		href: activity.data.url ?? '/community/',
	}));

const upcomingEvents = [...upcomingTalks, ...upcomingCommunity]
	.sort((a, b) => a.date.valueOf() - b.date.valueOf())
	.slice(0, 3);

const stats = [
	{ value: '25+', label: 'years_experience' },
	{ value: '45+', label: 'engineers_led' },
	{ value: '03', label: 'continents' },
	{ value: 'DUB', label: 'based_in_ireland' },
];

const achievements = [
	'Built engineering orgs from scratch to 45+ people',
	'Led architecture transformation from data monolith to event-driven data mesh',
	'Designed and delivered a multi-tenant, multi-country integration platform supporting real-time data ingestion and orchestration across IE, UK, and US markets',
	'Accelerated delivery and improved platform reliability through a Team Topologies redesign',
	'Developed and presented an original framework applying Team Topologies, Data Mesh and OWASP LLM06 principles to govern AI agent adoption, addressing bounded scope, guardrails, and human oversight at organisational scale',
];

const signalFlags = [
	'org-design',
	'event-driven',
	'data-mesh',
	'distributed-systems',
	'integration',
	'observability',
	'team-topologies',
	'agentic-ai',
	'mentorship',
	'public-speaking',
];

const explore = [
	{ href: '/experience/', kicker: '~/experience', title: 'Timeline & stack', desc: 'Full role history and technology depth' },
	{ href: '/speaking/', kicker: '~/speaking', title: 'Talks & podcasts', desc: 'Conference talks and guest appearances' },
	{ href: '/community/', kicker: '~/community', title: 'Organizing', desc: 'Meetups and practitioner communities' },
	{ href: '/topologies/', kicker: '~/topologies', title: 'My work in 3D', desc: 'An interactive Team Topologies board' },
];

const languages = [
	{ name: 'Italian', level: 'Native' },
	{ name: 'English', level: 'Fluent' },
	{ name: 'French', level: 'Intermediate' },
	{ name: 'German', level: 'Basic' },
	{ name: 'Spanish', level: 'Basic' },
];
---

<BaseLayout title="Domenico Fioravanti — Senior Engineering Leader">
	<section class="hero">
		<div class="hero-top">
			<div class="hero-intro">
				<span class="section-label">Senior Engineering Leader &middot; Sociotechnical Architect</span>
				<h1>Domenico Fioravanti</h1>
				<p class="tagline-lead">
					<span class="prompt-marker">&gt;</span>
					Aligning team structures, ways of working, platform architecture, and AI adoption to
					maximise flow, resilience, and business outcomes.<span class="cursor" aria-hidden="true"></span>
				</p>
			</div>
			<div class="hero-profile">
				<div class="hero-photo">
					<Picture
						src={domenicoPhoto}
						alt="Domenico Fioravanti"
						formats={['avif', 'webp']}
						fallbackFormat="jpg"
						width={160}
						height={160}
						densities={[1, 2]}
						loading="eager"
						fetchpriority="high"
					/>
				</div>
				<a class="btn-linkedin hero-linkedin" href={LINKEDIN_URL}>Connect on LinkedIn</a>
			</div>
		</div>

		{upcomingEvents.length > 0 && (
			<div class="next-up">
				<span class="next-up-label bracket-label">next up</span>
				<ul class="next-up-list">
					{upcomingEvents.map((event) => (
						<li>
							<a href={event.href} class="next-up-item">
								<span class="next-up-kind">{event.kind}</span>
								<span class="next-up-title">{event.title}</span>
								<span class="next-up-meta">{event.context} &middot; {formatEventDate(event.date)}</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		)}

		<div class="stats">
			{stats.map((stat) => (
				<div class="stat">
					<span class="stat-value">{stat.value}</span>
					<span class="stat-label">{stat.label}</span>
				</div>
			))}
		</div>

		<a class="preview-3d" href="/topologies/">
			<Picture
				src={topologiesPreview}
				alt="3D Team Topologies board: stream-aligned teams on a platform, wrapped by a career timeline from 2000 to 2026"
				formats={['avif', 'webp']}
				fallbackFormat="jpg"
				widths={[480, 760, 1200, 1520]}
				sizes="(min-width: 808px) 760px, calc(100vw - 3rem)"
			/>
			<span class="preview-3d-caption">
				<span class="preview-3d-kicker">interactive</span>
				<span class="preview-3d-title">Explore my work in 3D &rarr;</span>
			</span>
		</a>
	</section>

	<section>
		<h2 class="section-label section-heading">profile</h2>
		<p>
			Engineering leader with 25+ years of experience building and scaling tech orgs across
			Europe, US, and LATAM, and data-intensive platforms. I operate as a Sociotechnical
			Architect, intentionally aligning team structures, ways of working, and platform
			architecture to maximise flow, resilience, and business outcomes.
		</p>
		<p>
			Specialist in event-driven architecture, real-time data pipelines, and integration
			ecosystems, from Kafka-based streaming to third-party API and partner integrations.
			Proven track record of building engineering organisations from zero to 45+ people,
			leading complex platform modernisations, and driving scalable, high-reliability systems
			across e-commerce, healthcare, and SaaS.
		</p>
		<p>
			Actively shaping engineering organisation design for the agentic AI era, applying Team
			Topologies and bounded-agency principles to govern AI adoption safely at scale, while
			driving hands-on adoption of AI-assisted development across engineering teams.
		</p>
		<p>
			Regular speaker and community organiser on event streaming, data platforms, and engineering
			organisation design.
		</p>
	</section>

	<section>
		<h2 class="section-label section-heading">achievements</h2>
		<ol class="achievements">
			{achievements.map((item) => (
				<li>
					<span class="idx">ok</span>
					<span>{item}</span>
				</li>
			))}
		</ol>
	</section>

	<section>
		<h2 class="section-label section-heading">focus</h2>
		<ul class="chip-list">
			{signalFlags.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section>
		<h2 class="section-label section-heading">Explore</h2>
		<ul class="explore-grid">
			{explore.map((item) => (
				<li>
					<a class="explore-card" href={item.href}>
						<span class="explore-kicker">{item.kicker}</span>
						<span class="explore-title">{item.title}</span>
						<span class="explore-desc">{item.desc}</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section>
		<div class="split-grid">
			<div class="split-col">
				<h2 class="section-label section-heading">Education</h2>
				<ul class="plain-list">
					<li>
						<strong>MSc Computer Science / Software Engineering</strong> — University of Rome
						"La Sapienza"
					</li>
					<li><strong>European Baccalaureate</strong> — European School Brussels I</li>
				</ul>
			</div>
			<div class="split-col">
				<h2 class="section-label section-heading">Languages</h2>
				<ul class="plain-list inline">
					{languages.map((lang) => (
						<li>{lang.name} <span class="lang-level">{lang.level}</span></li>
					))}
				</ul>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero h1 {
		margin-bottom: 0.25rem;
	}
	.hero-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}
	.hero-intro {
		flex: 1;
		min-width: 240px;
	}
	/* Photo and LinkedIn button form one card: the button sits flush under the photo at the same width. */
	.hero-profile {
		width: 160px;
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
	}
	.hero-photo {
		width: 160px;
		height: 160px;
		border: 1px solid var(--line);
		border-bottom: 0;
		background: var(--bg-panel);
	}
	.hero-linkedin {
		display: block;
		padding: 0.55rem 0.25rem;
		font-size: 0.75rem;
		text-align: center;
		white-space: nowrap;
		border-radius: 0;
	}
	.hero-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.explore-grid {
		margin: 1rem 0 0;
	}
	.preview-3d {
		position: relative;
		display: block;
		margin: 1.5rem 0;
		border: 1px solid var(--line);
		overflow: hidden;
		color: var(--fg);
		text-decoration: none;
	}
	.preview-3d img {
		display: block;
		width: 100%;
		height: auto;
		transition: transform 400ms ease;
	}
	.preview-3d:hover img,
	.preview-3d:focus-visible img {
		transform: scale(1.03);
	}
	.preview-3d-caption {
		position: absolute;
		left: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.75rem 1rem;
		background: var(--bg-panel);
		border-top: 1px solid var(--accent);
		border-right: 1px solid var(--accent);
	}
	.preview-3d-kicker {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.preview-3d-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.05rem;
	}
	.preview-3d:hover .preview-3d-title {
		color: var(--accent);
	}
	@media (prefers-reduced-motion: reduce) {
		.preview-3d img {
			transition: none;
		}
	}
	.next-up {
		margin: 1.5rem 0;
		border: 1px solid var(--accent);
		background: var(--bg-panel);
		padding: 1rem 1.25rem;
	}
	.next-up-label {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 0.85rem;
	}
	.next-up-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}
	.next-up-list li + li {
		padding-top: 0.85rem;
		border-top: 1px solid var(--line);
	}
	.next-up-item {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		color: var(--fg);
		text-decoration: none;
	}
	.next-up-kind {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.next-up-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.05rem;
	}
	.next-up-item:hover .next-up-title {
		color: var(--accent);
	}
	.next-up-meta {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--muted);
	}
</style>
