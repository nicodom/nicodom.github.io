---
import '../styles/theme.css';
import { GITHUB_URL, LINKEDIN_URL } from '../lib/contact';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Domenico Fioravanti — Senior Engineering Leader.' } = Astro.props;
const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/experience/', label: 'Experience' },
	{ href: '/speaking/', label: 'Speaking' },
	{ href: '/community/', label: 'Community' },
	{ href: '/contact/', label: 'Contact' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500;600&display=swap"
		/>
		<script is:inline>
			(function () {
				var mode = null;
				try {
					mode = localStorage.getItem('mode');
				} catch (e) {}
				if (!mode) {
					mode = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.dataset.mode = mode;
			})();
		</script>
	</head>
	<body>
		<div class="status-bar">
			<span><span class="status-dot"></span>Open to new roles &middot; Dublin, IE</span>
			<span>Sys.uptime: 25+ yrs</span>
		</div>
		<header class="site-header">
			<a class="brand" href="/">domenico<span class="at">@</span>fioravanti</a>
			<nav>
				<ul>
					{nav.map((item) => (
						<li>
							<a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))}
				</ul>
				<div class="theme-controls">
					<button id="mode-toggle" class="mode-toggle" type="button" aria-label="Toggle light and dark mode">
						&nbsp;
					</button>
				</div>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p class="footer-copy">&copy; {new Date().getFullYear()} Domenico Fioravanti</p>
			<div class="footer-links">
				<a href={LINKEDIN_URL}>LinkedIn</a>
				<a href={GITHUB_URL}>GitHub</a>
			</div>
		</footer>
		<script is:inline>
			(function () {
				var modeToggle = document.getElementById('mode-toggle');
				var root = document.documentElement;

				function renderModeToggle() {
					if (!modeToggle) return;
					var isDark = root.dataset.mode === 'dark';
					modeToggle.textContent = isDark ? '☀️ Light' : '🌙 Dark';
					modeToggle.setAttribute('aria-pressed', String(isDark));
				}

				if (modeToggle) {
					renderModeToggle();
					modeToggle.addEventListener('click', function () {
						var next = root.dataset.mode === 'dark' ? 'light' : 'dark';
						root.dataset.mode = next;
						try {
							localStorage.setItem('mode', next);
						} catch (e) {}
						renderModeToggle();
					});
				}
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--max-width: 760px;
	}
</style>
